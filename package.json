{
  "name": "apsu-frontend-takehome",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src .storybook scripts/*.mjs *.json *.mjs *.ts README.md",
    "test:ui": "node scripts/verify-ui.mjs",
    "test:storybook": "node scripts/verify-storybook.mjs",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build",
    "assets:download": "node scripts/download-assets.mjs"
  },
  "dependencies": {
    "@fontsource/work-sans": "^5.2.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@storybook/addon-a11y": "^10.0.0",
    "@storybook/nextjs-vite": "^10.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.9",
    "storybook": "^10.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
